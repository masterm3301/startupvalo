# ── Option 1: OpenAI (gpt-4o-mini ≈ $0.01 per valuation) ──
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ── Option 2: Groq — free tier, very fast ──
# OPENAI_API_KEY=gsk_...          ← your Groq key goes here
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# ── Option 3: Anthropic (once you top up credits) ──
# Uses the Anthropic-compatible OpenAI endpoint (add anthropic to requirements)
# Or switch back to the Anthropic SDK version

# ── Option 4: Ollama — fully local, free ──
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3
